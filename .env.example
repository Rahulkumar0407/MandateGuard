# --- Database (PostgreSQL) ---
# Connection string used by Prisma. Provide a real Postgres instance for local
# dev (e.g. a local install, Docker, or a hosted provider). Format:
# postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=

# --- Razorpay (Test Mode) ---
# Generate these from the Razorpay Dashboard in TEST mode.
# NEVER expose the secret to the browser and NEVER commit real values.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
